<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body { font-family: Arial, sans-serif; color: #333; line-height: 1.4; }
        .invoice-box { max-width: 800px; margin: auto; padding: 10px; font-size: 14px; }
        
        /* Pengganti Flexbox pakai Tabel */
        table { width: 100%; line-height: inherit; text-align: left; border-collapse: collapse; }
        table td { padding: 5px; vertical-align: top; }
        
        .header { margin-bottom: 30px; }
        .title { font-size: 24px; font-weight: bold; text-align: right; }
        
        /* Styling Tabel Barang */
        .items-table th {background-color: rgb(249, 250, 251);font-weight: bold; padding: 10px; }
        .items-table td { border-top: 1px solid #eeeeee; padding: 10px; }
        .text-right { text-align: right; }
        .total-section { margin-top: 20px; float: right; width: 30%; }
        .font-bold { font-weight: bold; }
    </style>
</head>
<body>
    <div class="invoice-box">
        <!-- Header: Pakai Tabel untuk Kiri & Kanan -->
        <table class="header">
            <tr>
                <td>
                    <img src="<%= logoPath %>" style="width: 150px; height: auto;">
                </td>
                <td class="text-right">
                    <div class="title">INVOICE</div>
                    <p><%= data.transaction_no %><br>
                       INV<%= new Date().getFullYear().toString().slice(-2) %><%= String(new Date().getMonth() + 1).padStart(2, '0') %><%= String(data.transaction_no ).slice(-4) %>
                    </p>
                </td>
            </tr>
        </table>

        <!-- Info Alamat -->
        <table style="margin-bottom: 40px;">
            <tr>
                <td style="width: 50%;">
                    <span style="color: #999;">Ditagihkan Kepada:</span><br>
                    <span class="font-bold"><%= data.user?.fullname %></span><br>
                    <%= data.user?.email || "No email"%>
                </td>
                <td class="text-right">
                    <span style="color: #999;">Metode Pembayaran:</span><br>
                    <span class="font-bold">Bank Central Asia (BCA)</span><br>
                    No Rek: 7131720452<br>
                    PT. Kolaborasi Para Sahabat
                </td>
            </tr>
        </table>

        <!-- Tabel Produk -->
        <table class="items-table">
            <thead>
                <tr>
                    <th>Deskripsi Layanan</th>
                    <th style="text-align: center;">Jumlah Pesan</th>
                    <th class="text-right">Harga</th>
                </tr>
            </thead>
            <tbody>
                <% if (data.details && data.details.length > 0) {
                    const groupedInvoiceItems = data.details.reduce((acc, detail) => {
                        const key = `${detail.product_name || 'Produk'}|${detail.room_types || 'Unknown'}`;
                        if (!acc[key]) {
                            acc[key] = {
                                product_name: detail.product_name,
                                room_types: detail.room_types,
                                departure_date: detail.departure_date,
                                price: 0,
                                qty: 0
                            };
                        }
                        acc[key].qty += 1;
                        acc[key].price += Number(detail.price || 0);
                        return acc;
                    }, {});
                %>
                    <% Object.values(groupedInvoiceItems).forEach(item => { %>
                        <tr>
                            <td>
                                <strong><%= item.product_name %></strong><br>
                                <small style="color: #666;"><%= new Date(item.departure_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></small>
                            </td>
                            <td style="text-align: center;"><%= item.qty %>x <%= item.room_types %></td>
                            <td class="text-right">Rp <%= item.price.toLocaleString('id-ID') %></td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>

        <!-- Total Akhir -->
        <div class="total-section">
            <table style="border-top: 1px solid #eee;">
                <tr>
                    <td class="font-bold text-right">TOTAL AKHIR</td>
                </tr>
                <tr>
                    <td class="font-bold text-right" style="font-size: 18px; color: #000;">
                        Rp. <%= data.total_price.toLocaleString('id-ID') %>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</body>
</html>