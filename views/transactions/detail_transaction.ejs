<div class="flex-1  overflow-y-auto p-6 lg:p-10 scroll-smooth flex flex-col">
    <div class="flex-1 bg-white rounded-xl">
         <div class="grid grid-rows-1 lg:grid-rows-1 gap-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4 bg-white p-6 ">
                <div class="flex flex-col items-start">
                    <div class="flex items-center gap-2">
                        <p class="text-md font-bold text-gray-800 tracking-wider font-semibold">ID Transaksi:</p>
                    <h1 class="text-md font-bold text-gray-800"><%= data.transaction_no %></h1>
                    </div>
                    <p class="text-sm text-gray-400 mt-1">Tanggal: <%= new Date(data.created_at).toLocaleDateString('id-ID') %></p>
                </div>
                <div class="flex items-center gap-3">
                    <% 
                        
                        let statusClass = data.status === 'SUCCESS' ? 'bg-green-100 text-green-800 border-green-200' : 'bg-yellow-100 text-yellow-800 border-yellow-200';

                        let dotClass = data.status === 'SUCCESS' ? 'bg-green-500' : 'bg-yellow-500';
                    %>
                    <span class="<%= statusClass %> text-sm font-semibold p-2 border flex rounded-xl items-center">
                        <span class="w-2 h-2 me-2 <%= dotClass %> rounded-full"></span>
                        <%= data.status %>
                    </span>
                    <button data-modal-target="invoiceModal" data-modal-toggle="invoiceModal" class="flex items-center gap-2 px-5 py-2.5 bg-blue-700 text-white rounded-lg hover:bg-blue-900 transition shadow-md">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        Lihat Invoice
                    </button>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 px-4">
            
            <div class="lg:col-span-2 space-y-6">
                
                <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">

                    <!-- <pre>
    Type of flights: <%= typeof data.details[0].flights_snapshot %>
    Raw data: <%= JSON.stringify(data.details[0].flights_snapshot) %>
    </pre> -->
                    <div class="py-3 px-6 ">
                    <h2 class="font-semibold text-lg pb-2 mb-2 border-b">
                            Informasi Paket
                    </h2>
                   <div class="py-10">
                     <% if (data.details && data.details.length > 0) {
                            const packageCounts = data.details.reduce((acc, detail) => {
                                const type = detail.room_types || 'Unknown';
                                acc[type] = (acc[type] || 0) + 1;
                                return acc;
                            }, {});
                        %>    
                        <div class="grid grid-cols-2 items-center gap-4 mb-4">
                             <div>
                                <h3 class="text-xl font-bold text-gray-800 mb-2"><%= data.details[0].product_name %></h3>
                                <!-- <p class="text-sm text-gray-500">Jumlah Pesanan: <%= data.details.length %></p> -->
                             </div>
                             <div class="grid grid-cols-1">
                                <% Object.entries(packageCounts).forEach(([roomType, qty]) => { %>
                                    <span class="text-gray-400 text-sm"><%= qty %>x <%= roomType %></span>
                                <% }) %>
                             </div>
                        </div>
                        <div class="grid grid-cols-2 gap-y-4 text-sm">
                            <% if (data.details[0].flights_snapshot && Array.isArray(data.details[0].flights_snapshot)) { %>
                                <% data.details[0].flights_snapshot.forEach(flight => { %>
                                    <div>
                                        <p class="text-gray-400">Maskapai <%= flight.type === 'Departure' ? 'Keberangkatan' : 'Kepulangan' %></p>
                                        <p class="font-medium text-gray-700"><%= flight.airline_name %></p>
                                    </div>
                                <% }) %>
                            <% } %>

                            <div>
                                <p class="text-gray-400">Tanggal Keberangkatan</p>
                                <p class="font-medium text-gray-700">
                                    <%= new Date(data.details[0].departure_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                </p>
                            </div>

                            <div>
                                <p class="text-gray-400">Informasi Hotel</p>
                                <% if (data.details[0].hotels_snapshot && Array.isArray(data.details[0].hotels_snapshot)) { %>
                                    <% data.details[0].hotels_snapshot.forEach(hotel => { %>
                                        <p class="font-medium text-gray-700 italic text-emerald-islamic">
                                            <%= hotel.city %>: <%= hotel.name %> 
                                            (<%= '★'.repeat(hotel.rating) %>) 
                                        </p>
                                    <% }) %>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                   </div>
                    </div>
                </div>

                
            </div>

            <div class="lg:col-span-1">
                <div class="bg-white rounded-xl  border border-gray-200 ">
                    <div class="p-6">
                        <h2 class="text-lg font-bold text-gray-800 mb-4 pb-3 border-b">Ringkasan Pembayaran</h2>
                        <div class="space-y-4 mb-4">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-500 text-sm">Harga</span>
                                <span class="font-semibold">Rp <%= data.total_price.toLocaleString('id-ID') %></span>
                            </div>
                           <div class="flex justify-between text-sm">
                                <span class="text-gray-500">Metode Pembayaran</span>
                                <span class="font-semibold"><%= data.payment_method %></span>
                            </div>
                            <!-- <div class="flex justify-between text-sm">
                                <span class="text-emerald-islamic font-medium">Diskon Promo</span>
                                <span class="text-emerald-islamic font-semibold">-Rp 1.000.000</span>
                            </div> -->
                        </div>
                        <div class="pt-4 border-t border-dashed border-gray-200">
                           <div class="flex flex-col justify-between items-left mb-6">
                                <span class="text-base font-bold text-gray-800">Total Dibayar</span>
                                <span class="text-xl font-extrabold text-travel-dark">Rp <%= data.total_price.toLocaleString('id-ID') %></span>
                            </div>
                            <button 
                            data-modal-target="approvePaymentModal" data-modal-toggle="approvePaymentModal"
                            class="w-full bg-green-500 text-white font-bold py-3 rounded-xl hover:bg-green-700 transition shadow-lg shadow-green-100">
                                Cek Pembayaran
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-2 bg-white px-4 py-7">
            
            <div id="accordion-jamaah" data-accordion="collapse" class="rounded-xl border border-t border-gray-200 relative overflow-x-auto ">
                        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
                            <h2 class="font-bold text-gray-800">Data Jamaah</h2>
                        </div>
                        <table class="w-full text-sm text-left border-collapse px-14">
                            <thead class="bg-gray-50">
                                <tr class=" border-t">
                                    <th class="py-3 px-10 font-bold text-left border-r ">Fullname</th>
                                    <th class="py-3 px-10 font-bold text-left border-r ">Email</th>
                                    <th class="py-3 px-10 text-left font-bold border-r ">No Telp</th>
                                    <th class="py-3 px-10 text-left font-bold border-r ">Gender</th>
                                    <th class="py-3 px-10 text-left font-bold border-r ">Dokumen</th>
                                    
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% if (Array.isArray(data.jamaah) && data.jamaah.length > 0) { %>
                                    <% data.jamaah.forEach((jamaah, index) => { %>
                                        <tr>
                                            <td class="py-2 px-10 border-b border-r">
                                                <p class="font-medium text-left text-gray-800"><%= jamaah.fullname %></p>
                                            </td>
                                            <td class="py-2 px-10 border-b border-r">
                                                <p class="font-medium text-left text-gray-800"><%= jamaah.email %></p>
                                            </td>
                                            <td class="py-2 px-10 border-b border-r">
                                                <p class="font-medium text-left text-gray-800"><%= jamaah.phone %></p>
                                            </td>
                                            <td class="py-2 px-10 border-b border-r">
                                                <p class="font-medium text-left text-gray-800"><%= jamaah.gender === 'L' ? 'Laki-laki' : jamaah.gender === 'P' ? 'Perempuan' : jamaah.gender %></p>
                                            </td>
                                            <td class="py-2 px-10 flex justify-left border-b ">
                                                <button onclick="openDocumentModal('<%= jamaah.fullname %>', '<%= jamaah.img_ktp %>', '<%= jamaah.img_kk %>', '<%= jamaah.img_passpor %>', '<%= jamaah.img_diri %>', '<%= jamaah.img_akta_kelahiran %>')" class="flex  items-center gap-2 px-3 py-2 bg-blue-400 text-white rounded-lg hover:bg-blue-600 transition shadow-md">
                                                    Lihat
                                                </button>
                                            </td>
                                            
                                            
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td class="py-4 px-10 text-center text-gray-500" colspan="7">Belum ada data jamaah untuk transaksi ini.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
            </div>
        </div>
        <div class="bg-white px-4 py-7">
            <div id="accordion-payment" data-accordion="collapse" class="rounded-xl border border-t border-gray-200 relative overflow-x-auto">
                <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
                    <h2 class="font-bold text-gray-800">Detail Pembayaran</h2>
                </div>
                <table class="w-full text-sm text-left border-collapse px-14">
                    <thead class="bg-gray-50">
                        <tr class="border-t">
                            <th class="py-3 px-10 font-bold text-left border-r ">#</th>
                            <th class="py-3 px-10 font-bold text-left border-r ">Title</th>
                            <th class="py-3 px-10 font-bold text-left border-r ">Jatuh tempo</th>
                            <th class="py-3 px-10 font-bold text-left border-r ">Jumlah</th>
                            <th class="py-3 px-10 font-bold text-left border-r ">Status</th>
                            <th class="py-3 px-10 font-bold text-left border-r ">Bukti pembayaran</th>
                        </tr>
                    </thead>
                 <tbody class="divide-y divide-gray-500">
                    <% if (Array.isArray(data.installments) && data.installments.length > 0) { %>
                        <% data.installments.forEach((installment, index) => { %>
                            <tr>
                                <!-- Nomor Urut / Index -->
                                <td class="py-2 px-10 border-b border-r">
                                    <p class="font-medium text-left text-gray-800"><%= index + 1 %></p>
                                </td>

                                <!-- Label Termin Dinamis -->
                                <td class="py-2 px-10 border-b border-r">
                                    <p class="font-medium text-left text-gray-800">
                                        <% if (installment.installment_number === 1) { %>
                                            DP
                                        <% } else { %>
                                            Pelunasan <%= installment.installment_number - 1 %>
                                        <% } %>
                                    </p>
                                </td>

                                <!-- Due Date Dinamis Sesuai Item -->
                                <td class="py-2 px-10 border-b border-r">
                                    <p class="font-medium text-left text-gray-800">
                                        <%= installment.due_date ? new Date(installment.due_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-' %>
                                    </p>
                                </td>

                                <!-- Amount Dinamis -->
                                <td class="py-2 px-10 border-b border-r">
                                    <p class="font-medium text-left text-gray-800">
                                        Rp <%= Number(installment.amount).toLocaleString('id-ID') %>
                                    </p>
                                </td>

                                <!-- Status -->
                                <td class="py-2 px-10 border-b border-r">
                                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full 
                                        <%= installment.status === 'SUCCESS' ? 'bg-green-100 text-green-800' : 
                                        (installment.status === 'PENDING' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800') %>">
                                        <%= installment.status %>
                                    </span>
                                </td>

                                <!-- Aksi -->
                                <td class="py-2 px-10 border-b border-r ">
                                    <button type="button" 
                                    onclick="openInstallmentModal('<%= installment.id %>', '<%= installment.evidence_url || '' %>', '<%= installment.installment_number %>', '<%= installment.amount %>')"
                                    class="flex items-center gap-2 px-3 py-2 bg-blue-500 text-white text-xs font-semibold rounded-lg hover:bg-blue-600 transition shadow-md">
                                    <i class="ph ph-eye text-sm"></i>
                                    Lihat
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td class="py-4 px-10 text-center text-gray-500" colspan="6">
                                Jamaah tidak melakukan cicilan.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
                </table>
            </div>
        </div>
    </div>
        <!-- <div class="bg-black text-green-400 p-4 font-mono text-xs">
    DEBUG DATA DETAIL 0:
    <%= JSON.stringify(data.details[0]) %>
</div>  -->
       
    </div>

    <div id="detailJamaah" aria-hidden="true" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full bg-black bg-opacity-50 backdrop-blur-sm">
        <div class="relative w-full max-w-4xl max-h-full ">
            <div class="relative bg-white rounded-lg shadow-2xl border border-gray-100">
                <!-- Header -->
                <div class="flex items-center justify-between p-6 border-b border-gray-100 bg-gradient-to-r ">
                    <h3 class="text-2xl font-bold text-white">
                        Dokumen Jamaah: <span id="jamaahName"></span>
                    </h3>
                    <button type="button" onclick="closeDocumentModal()" class=" hover:bg-white hover:bg-opacity-20  text-sm w-8 h-8 inline-flex justify-center items-center">
                        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                        </svg>
                    </button>
                </div>

                <!-- Tab Navigation -->
                <div class="flex border-b border-gray-100 bg-gray-50">
                    <button onclick="switchDocumentTab('ktp')" id="tab-ktp" class="flex-1 py-4 px-6 font-semibold text-gray-700 border-b-2  bg-white  transition">
                        <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 100 2H4a1 1 0 100-2V4z"></path></svg>
                        KTP
                    </button>
                    <button onclick="switchDocumentTab('kk')" id="tab-kk" class="flex-1 py-4 px-6 font-semibold text-gray-700 border-b-2 border-transparent  transition">
                        <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 100 2H4a1 1 0 100-2V4z"></path></svg>
                        KK
                    </button>
                    <button onclick="switchDocumentTab('passpor')" id="tab-passpor" class="flex-1 py-4 px-6 font-semibold text-gray-700 border-b-2 border-transparent transition">
                        <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 100 2H4a1 1 0 100-2V4z"></path></svg>
                        Passpor
                    </button>
                    <button onclick="switchDocumentTab('photo')" id="tab-photo" class="flex-1 py-4 px-6 font-semibold text-gray-700 border-b-2 border-transparent transition">
                        <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 100 2H4a1 1 0 100-2V4z"></path></svg>
                        Pas Foto
                    </button>
                     <button onclick="switchDocumentTab('akta')" id="tab-akta" class="flex-1 py-4 px-6 font-semibold text-gray-700 border-b-2 border-transparent transition">
                        <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 100 2H4a1 1 0 100-2V4z"></path></svg>
                        Akta Kelahiran
                    </button>
                </div>

                <!-- Content -->
                <div class="p-8">
                    <!-- KTP Tab -->
                    <div id="content-ktp" class="document-content block">
                        <p class="text-gray-600 font-semibold mb-4">Kartu Tanda Penduduk (KTP)</p>
                        <div class="flex justify-center">
                            <img id="ktp-image" src="" alt="KTP" class="max-w-full max-h-96 rounded-lg shadow-lg border border-gray-200">
                        </div>
                        <p id="ktp-empty" class="text-gray-400 text-center italic">Tidak ada data KTP</p>
                    </div>

                    <!-- KK Tab -->
                    <div id="content-kk" class="document-content hidden">
                        <p class="text-gray-600 font-semibold mb-4">Kartu Keluarga (KK)</p>
                        <div class="flex justify-center">
                            <img id="kk-image" src="" alt="KK" class="max-w-full max-h-96 rounded-lg shadow-lg border border-gray-200">
                        </div>
                        <p id="kk-empty" class="text-gray-400 text-center italic">Tidak ada data KK</p>
                    </div>

                    <!-- Passpor Tab -->
                    <div id="content-passpor" class="document-content hidden">
                        <p class="text-gray-600 font-semibold mb-4">Passpor</p>
                        <div class="flex justify-center">
                            <img id="passpor-image" src="" alt="Passpor" class="max-w-full max-h-96 rounded-lg shadow-lg border border-gray-200">
                        </div>
                        <p id="passpor-empty" class="text-gray-400 text-center italic">Tidak ada data Passpor</p>
                    </div>

                    <div id="content-photo" class="document-content hidden">
                        <p class="text-gray-600 font-semibold mb-4">Pas Foto</p>
                        <div class="flex justify-center">
                            <img id="photo-image" src="" alt="Pas Foto" class="max-w-full max-h-96 rounded-lg shadow-lg border border-gray-200">
                        </div>
                        <p id="photo-empty" class="text-gray-400 text-center italic">Tidak ada data Pas Foto</p>
                    </div>
                    <div id="content-akta" class="document-content hidden">
                        <p class="text-gray-600 font-semibold mb-4">Akta Kelahiran</p>
                        <div class="flex justify-center">
                            <img id="akta-image" src="" alt="Pas Foto" class="max-w-full max-h-96 rounded-lg shadow-lg border border-gray-200">
                        </div>
                        <p id="akta-empty" class="text-gray-400 text-center italic">Tidak ada data Akta kelahiran/Jamaah tidak mengupload Akta</p>
                    </div>
                </div>

                <!-- Footer -->
                <div class="flex justify-end gap-3 p-6 border-t border-gray-100 bg-gray-50">
                    <button onclick="closeDocumentModal()" class="px-5 py-2.5 text-gray-700 font-semibold bg-gray-200 rounded-lg hover:bg-gray-300 transition">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="showInstallmentModal" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] max-h-full flex items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm transition-opacity">
    <div class="relative w-full max-w-md max-h-full">
        <div class="relative bg-white rounded-2xl shadow-2xl border border-gray-100">
            <!-- Header Modal -->
            <div class="flex items-center justify-between p-4 border-b rounded-t">
                <h3 class="text-xl font-bold text-gray-800">
                    Bukti Pembayaran Cicilan
                </h3>
                <button type="button" onclick="closeInstallmentModal()" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center">
                    <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                    </svg>
                </button>
            </div>

            <!-- Body Modal -->
            <div class="p-6 text-center">
                <div class="bg-gray-50 rounded-xl p-4 mb-6 text-left border border-gray-200 space-y-2">
                    <div class="flex justify-between">
                        <span class="text-xs text-gray-400">Termin</span>
                        <span id="modalInstallmentTerm" class="text-xs font-bold text-gray-700 uppercase">-</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-xs text-gray-400">Nominal Tagihan</span>
                        <span id="modalInstallmentAmount" class="text-xs font-bold text-gray-700">Rp 0</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-xs text-gray-400">Metode</span>
                        <span class="text-xs font-bold text-gray-700 uppercase"><%= data.payment_method %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-xs text-gray-400">Jama'ah</span>
                        <span class="text-xs font-bold text-gray-700"><%= data.user?.fullname %></span>
                    </div>

                    <!-- Tempat Bukti Upload -->
                    <div class="mt-4 border-2 border-dashed border-gray-300 rounded-xl p-4 text-center">
                        <p class="text-xs text-gray-400 mb-2 font-bold uppercase">Bukti Transfer:</p>
                        <div id="evidenceContentCicilan" class="w-full text-center">
                            <!-- Injected via JavaScript -->
                        </div>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="flex gap-3">
                    <button type="button" onclick="closeInstallmentModal()" class="w-full text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 font-medium rounded-xl text-sm px-5 py-3 transition-all">
                        Batal
                    </button>
                    <button type="button" 
                        id="btnApproveInstallment" 
                        onclick="confirmApproveInstallmentBtn(selectedInstallmentId)" 
                        class="w-full text-white bg-green-600 hover:bg-green-700 shadow-lg shadow-green-200 font-bold rounded-xl text-sm px-5 py-3 transition-all flex items-center justify-center gap-2">
                        <i class="ph-bold ph-check"></i>
                        Ya, Approve
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

 <div id="approvePaymentModal" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] max-h-full flex items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm transition-opacity">
    <div class="relative w-full max-w-md max-h-full">
        <div class="relative bg-white rounded-2xl shadow-2xl border border-gray-100">
            <div class="flex items-center justify-between p-4 border-b rounded-t">
                <h3 class="text-xl font-bold text-gray-800">
                    Konfirmasi Pembayaran
                </h3>
                <button type="button" onclick="closeApproveModal()" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-hide="approvePaymentModal">
