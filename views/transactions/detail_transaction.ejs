                        Cetak PDF
                    </button>
            
                    </a>
                   
                </div>
            </div>
        </div>
    </div>

    <script>
        (function() {
            const transactionId = <%= data.id %>;
            const initialEvidenceUrl = `<%= data.evidence_url ? data.evidence_url : '' %>`;
            const evidenceContent = document.getElementById('evidenceContent');

            if (!evidenceContent) return;

            const resolveEvidenceUrl = (evidenceUrl) => {
                if (!evidenceUrl) return null;
                if (/^(https?:)?\/\//.test(evidenceUrl)) {
                    return evidenceUrl;
                }
                return `/assets/img/transactions/${encodeURIComponent(evidenceUrl)}`;
            };

            const renderNoEvidence = () => {
                evidenceContent.innerHTML = `
                    <i class="ph ph-image text-3xl text-gray-400 mb-2"></i>
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        Jama'ah belum mengunggah bukti pembayaran. Silahkan hubungi jama'ah untuk mendapatkan bukti transfer.
                    </p>
                `;
            };

            const renderEvidence = (evidenceUrl) => {
                const src = resolveEvidenceUrl(evidenceUrl);
                if (!src) {
                    renderNoEvidence();
                    return;
                }
                evidenceContent.innerHTML = `
                    <img class="max-h-64 rounded-lg shadow-md border mx-auto" src="${src}" alt="Bukti Transfer">
                    <a href="${src}" target="_blank" class="mt-3 text-xs text-blue-500 underline inline-block">
                        Lihat Ukuran Penuh
                    </a>
                `;
            };

            const tryRenderFromLocalData = () => {
                if (initialEvidenceUrl) {
                    renderEvidence(initialEvidenceUrl);
                    return true;
                }
                return false;
            };

            if (tryRenderFromLocalData()) {
                return;
            }

            fetch(`/api/transactions/${transactionId}`)
                .then((response) => response.json())
                .then((json) => {
                    if (!json || !json.success || !json.data || !json.data.evidence_url) {
                        console.warn('Evidence fetch failed or no evidence_url:', json);
                        renderNoEvidence();
                        return;
                    }
                    renderEvidence(json.data.evidence_url);
                })
                .catch((err) => {
                    console.error('Error fetching transaction evidence:', err);
                    renderNoEvidence();
                });
        })();
        
        // Bukti Cicilan
         let selectedInstallmentId = null;

        // Helper Resolve URL Bukti
        const resolveEvidenceUrl = (evidenceUrl) => {
            if (!evidenceUrl) return null;
            if (/^(https?:)?\/\//.test(evidenceUrl)) {
                return evidenceUrl;
            }
            return `/assets/img/transactions/${encodeURIComponent(evidenceUrl)}`;
        };

        // Fungsi Membuka Modal & Set Data Sesuai Termin yang Diklik
        function openInstallmentModal(installmentId, evidenceUrl, installmentNumber, amount) {
            selectedInstallmentId = installmentId;

            // 1. Set Label Termin
            const termText = Number(installmentNumber) === 1 ? 'DP' : `Pelunasan ${Number(installmentNumber) - 1}`;
            document.getElementById('modalInstallmentTerm').innerText = termText;

            // 2. Set Format Nominal
            document.getElementById('modalInstallmentAmount').innerText = `Rp ${Number(amount).toLocaleString('id-ID')}`;

            // 3. Render Gambar Bukti Transfer
            const evidenceContainer = document.getElementById('evidenceContentCicilan');
            const src = resolveEvidenceUrl(evidenceUrl);

            if (src) {
                evidenceContainer.innerHTML = `
                    <img class="max-h-64 rounded-lg shadow-md border mx-auto object-cover" src="${src}" alt="Bukti Transfer">
                    <a href="${src}" target="_blank" class="mt-3 text-xs text-blue-500 hover:underline inline-block font-medium">
                        <i class="ph ph-arrows-out-simple"></i> Lihat Ukuran Penuh
                    </a>
                `;
            } else {
                evidenceContainer.innerHTML = `
                    <i class="ph ph-image text-3xl text-gray-400 mb-1 inline-block"></i>
                    <p class="text-xs text-gray-500">
                        Jama'ah belum mengunggah bukti pembayaran untuk termin ini.
                    </p>
                `;
            }

            // 4. Tampilkan Modal
            const modal = document.getElementById('showInstallmentModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        // Fungsi Menutup Modal
        function closeInstallmentModal() {
            selectedInstallmentId = null;
            const modal = document.getElementById('showInstallmentModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
        

     // Modal Jamaah Dokumen Functions
        function openDocumentModal(jamaahName, ktpImage, kkImage, pasportImage, photoImage, aktaImage) {
            const modal = document.getElementById('detailJamaah');
            
            // Set jamaah name
            document.getElementById('jamaahName').textContent = jamaahName;
            
            // Resolve image URLs
            const resolveImageUrl = (imageName) => {
                if (!imageName || imageName === 'null' || imageName === '') {
                    return null;
                }
                if (/^(https?:)?\/\//.test(imageName)) {
                    return imageName;
                }
                return `/assets/img/transactions/jamaah/${encodeURIComponent(imageName)}`;
            };
            
            // Setup KTP
            const ktpUrl = resolveImageUrl(ktpImage);
            const ktpImageEl = document.getElementById('ktp-image');
            const ktpEmptyEl = document.getElementById('ktp-empty');
            if (ktpUrl) {
                ktpImageEl.src = ktpUrl;
                ktpImageEl.style.display = 'block';
                ktpEmptyEl.style.display = 'none';
            } else {
                ktpImageEl.style.display = 'none';
                ktpEmptyEl.style.display = 'block';
            }
            
            // Setup KK
            const kkUrl = resolveImageUrl(kkImage);
            const kkImageEl = document.getElementById('kk-image');
            const kkEmptyEl = document.getElementById('kk-empty');
            if (kkUrl) {
                kkImageEl.src = kkUrl;
                kkImageEl.style.display = 'block';
                kkEmptyEl.style.display = 'none';
            } else {
                kkImageEl.style.display = 'none';
                kkEmptyEl.style.display = 'block';
            }
            
            // Setup Passpor
            const pasportUrl = resolveImageUrl(pasportImage);
            const pasportImageEl = document.getElementById('passpor-image');
            const pasportEmptyEl = document.getElementById('passpor-empty');
            if (pasportUrl) {
                pasportImageEl.src = pasportUrl;
                pasportImageEl.style.display = 'block';
                pasportEmptyEl.style.display = 'none';
            } else {
                pasportImageEl.style.display = 'none';
                pasportEmptyEl.style.display = 'block';
            }

            // Setup pas foto
            const photoUrl = resolveImageUrl(photoImage);
            const photoImageEl = document.getElementById('photo-image');
            const photoEmptyEl = document.getElementById('photo-empty');
            if(photoUrl) {
                photoImageEl.src = photoUrl;
                photoImageEl.style.display = "block";
                photoEmptyEl.style.display = "none";
            }else {
                photoImageEl.style.display = "none";
                pasportEmptyEl.style.display = "block"
            }
            const aktaUrl = resolveImageUrl(aktaImage);
            const aktaImageEl = document.getElementById('akta-image');
            const aktaEmptyEl = document.getElementById('akta-empty');
            if(aktaUrl) {
                aktaImageEl.src = aktaUrl;
                aktaImageEl.style.display = "block";
                aktaEmptyEl.style.display = "none";
            }else {
                aktaImageEl.style.display = "none";
                aktaEmptyEl.style.display = "block"
            }
            
            // Show modal
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeDocumentModal() {
            const modal = document.getElementById('detailJamaah');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = 'auto';
            
            // Reset to first tab
            switchDocumentTab('ktp');
        }

        function switchDocumentTab(tabName) {
            // Hide all content
            const contents = document.querySelectorAll('.document-content');
            contents.forEach(content => content.classList.add('hidden'));
            
            // Remove active state from all tabs
            const tabs = document.querySelectorAll('[id^="tab-"]');
            tabs.forEach(tab => tab.classList.remove('border-blue-500', 'bg-white'));
            tabs.forEach(tab => tab.classList.add('border-transparent'));
            
            // Show selected content
            const selectedContent = document.getElementById(`content-${tabName}`);
            if (selectedContent) {
                selectedContent.classList.remove('hidden');
            }
            
            // Set active state on selected tab
            const selectedTab = document.getElementById(`tab-${tabName}`);
            if (selectedTab) {
                selectedTab.classList.remove('border-transparent');
                selectedTab.classList.add('border-blue-500', 'bg-white');
            }
        }

        // Close modal when clicking outside
        document.getElementById('detailJamaah').addEventListener('click', function(event) {
            if (event.target === this) {
                closeDocumentModal();
            }
        });
    </script>