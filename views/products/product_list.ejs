        <div class="overflow-x-auto px-10">
        <table id="productTable" class="w-full border rounded-2xl p-0 text-left border-collapse">
          <thead>
            <tr
              class=" dark:bg-slate-800/50 border rounded-2xl border-gray-100 dark:border-dark-border text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold">
              <th class="p-5 w-24  border-b">Action</th>
              <th class="p-5 whitespace-nowrap  border-b">Nama Produk</th>
              <th class="p-5 whitespace-nowrap  border-b">Added By</th>
              <th class="p-5 whitespace-nowrap border-b">Harga</th>
             
              <th class="p-5 whitespace-nowrap border-b">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-dark-border" id="productTable">

          </tbody>
        </table>
      
