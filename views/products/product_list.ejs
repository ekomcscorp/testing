        <a href="#" class="hover:text-primary-500 transition-colors">Dashboard</a>
        <span class="mx-2">/</span>
        <span class="text-gray-800 dark:text-gray-200">Products</span>
      </nav>
    </div>

    <% if (typeof akses !== 'undefined' && akses.add_level === 'Y') { %>
    <a href="/createProduct"
      class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-xl transition-colors shadow-lg shadow-primary-500/30 no-underline">
      <i class="ph ph-plus text-lg"></i>
      <span>Tambah Produk</span>
    </a>
    <% } %>

  </div>
