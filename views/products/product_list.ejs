      <div id="detailProductModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 transition-opacity bg-gray-500 bg-opacity-75 dark:bg-slate-900/80 backdrop-blur-sm" onclick="closeDetailModal()"></div>

        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <div class="inline-block w-full max-w-2xl overflow-hidden text-left align-middle transition-all transform bg-white rounded-2xl shadow-xl dark:bg-slate-800 sm:my-8 sm:align-middle">
            
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-800/50">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="modal-title">
                    Detail Produk
                </h3>
                <button onclick="closeDetailModal()" class="p-1.5 text-gray-400 rounded-lg hover:bg-gray-100 dark:hover:bg-slate-700 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">
                    <i class="ph-bold ph-x text-xl"></i>
                </button>
            </div>

            <div class="px-6 py-4 space-y-6 max-h-[calc(100vh-200px)] overflow-y-auto">
                
                <div class="flex flex-col sm:flex-row gap-4 items-start pb-4 border-b border-gray-100 dark:border-slate-700">
                    <img id="md-thumbnail" src="" alt="Thumbnail" class="w-24 h-24 sm:w-28 sm:h-28 object-cover rounded-xl shadow-sm flex-shrink-0 bg-gray-100">
                    <div class="space-y-1.5 grow">
                        <span id="md-status" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium"></span>
                        <h4 id="md-nama" class="text-xl font-bold text-gray-900 dark:text-white leading-tight"></h4>
                        <p class="text-sm text-gray-500 dark:text-slate-400">Added by: <span id="md-creator" class="font-medium"></span></p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                
                    <div class="p-3 rounded-xl bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 flex items-center gap-3">
                        <div class="p-2 bg-blue-600 rounded-lg text-white">
                            <i class="ph-bold ph-buildings text-xl"></i>
                        </div>
                        <div>
                            <p class="text-xs text-blue-600 dark:text-blue-400 font-medium tracking-wider uppercase">Kamar Quad</p>
                            <p id="md-room-count-quad" class="text-lg font-bold text-blue-700 dark:text-blue-300">0 Seat</p>
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 flex items-center gap-3">
                        <div class="p-2 bg-blue-600 rounded-lg text-white">
                            <i class="ph-bold ph-buildings text-xl"></i>
                        </div>
                        <div>
                            <p class="text-xs text-blue-600 dark:text-blue-400 font-medium tracking-wider uppercase">Kamar Triple</p>
                            <p id="md-room-count-triple" class="text-lg font-bold text-blue-700 dark:text-blue-300">0 Seat</p>
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 flex items-center gap-3">
                        <div class="p-2 bg-blue-600 rounded-lg text-white">
                            <i class="ph-bold ph-buildings text-xl"></i>
                        </div>
                        <div>
                            <p class="text-xs text-blue-600 dark:text-blue-400 font-medium tracking-wider uppercase">Kamar Double</p>
                            <p id="md-room-count-double" class="text-lg font-bold text-blue-700 dark:text-blue-300">0 Seat</p>
                        </div>
                    </div>

                </div>

                <div class="space-y-3">
                    <h5 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                        <i class="ph-bold ph-airplane-takeoff text-lg text-primary-500"></i> Informasi Penerbangan
                    </h5>
                    
                    <div class="p-4 rounded-xl border border-gray-100 dark:border-slate-700 bg-gray-50/50 dark:bg-slate-900/30 space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-white dark:bg-slate-700 shadow-sm flex items-center justify-center border border-gray-100 dark:border-slate-600">
                                <i class="ph-bold ph-airplane text-blue-500 text-base"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400">Maskapai Keberangkatan</p>
                                <p id="md-flight-airline" class="text-sm font-bold text-gray-800 dark:text-white">-</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400">Maskapai Kepulangan</p>
                                <p id="md-flight-airline-return" class="text-sm font-bold text-gray-800 dark:text-white">-</p>
                            </div>
                        </div>

                        <div class="relative pl-6 border-l-2 border-dashed border-gray-200 dark:border-slate-700 ml-4 space-y-4">
                            <div class="relative">
                                <span class="absolute -left-[31px] top-0.5 bg-blue-600 w-3 h-3 rounded-full ring-4 ring-white dark:ring-slate-800"></span>
                                <p class="text-xs text-gray-400 font-medium">Keberangkatan</p>
                                <p id="md-flight-departure-airport" class="text-sm font-bold text-gray-800 dark:text-white">-</p>
                                
                            </div>
                            <div class="relative">
                                <span class="absolute -left-[31px] top-0.5 bg-blue-600 w-3 h-3 rounded-full ring-4 ring-white dark:ring-slate-800"></span>
                                <p class="text-xs text-gray-400 font-medium">Tanggal  Keberangkatan</p>
                               
                                <p id="md-flight-arrival-time" class="text-xs text-gray-500">-</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- <div class="space-y-3">
                    <h5 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider">Daftar Harga & Kamar</h5>
                    <div id="md-prices-list" class="divide-y divide-gray-100 dark:divide-slate-700 border border-gray-100 dark:border-slate-700 rounded-xl overflow-hidden">
                        </div>
                </div> -->

            </div>

            <div class="px-6 py-4 border-t border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-800/50 flex justify-end">
                <button type="button" onclick="closeDetailModal()" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 dark:bg-slate-700 dark:text-gray-200 dark:border-slate-600 dark:hover:bg-slate-600 transition-colors">
                    Tutup
                </button>
            </div>
        </div>
    </div>
</div>
